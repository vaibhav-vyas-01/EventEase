{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "organizer": {
      "root": "organizer",
      "framework": "vite"
    },
    "participant": {
      "root": "participant",
      "framework": "vite"
    }
  },
  "rewrites": [
    { "source": "/organizer", "destination": { "service": "organizer" } },
    { "source": "/organizer/(.*)", "destination": { "service": "organizer" } },
    { "source": "/(.*)", "destination": { "service": "participant" } }
  ]
}